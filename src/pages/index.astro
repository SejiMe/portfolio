---
import Base from '../layouts/BaseLayout.astro';
import Cards from '../components/EntryCards.astro';
import Splash from '../components/Splash.astro';
import {getCollection} from 'astro:content';
import {compareProjectsByDateOrYearDesc} from '../utils/projectDate';
import {info} from '../data/info';
const projects=(await getCollection('projects')).sort((a,b)=>compareProjectsByDateOrYearDesc(a.data,b.data));
const posts=(await getCollection('posts')).sort((a,b)=>+b.data.date-+a.data.date);
---
<Base title="Portfolio" home><main class="exhibition" aria-label="Portfolio chapters">
<section id="intro" class="chapter"><div class="hero"><div><p class="eyebrow">Full-stack & AI developer</p><h1 tabindex="-1">Systems with purpose.</h1><p class="lede">Software and AI workflows for your business.</p><div class="actions"><a class="button primary" href="#work">View work</a><a class="button" href="#contact">Get in touch</a></div></div><figure class="emblem-plate"><i aria-hidden="true"></i><img src="/portfolio/sej-logo.svg" alt="Sej ribbon emblem"/></figure></div></section>
<section id="work" class="chapter"><div class="chapter-body"><span id="projects"></span><h2>Selected work</h2><Cards entries={[projects.find(p=>p.slug==='meta-chatter'), projects.find(p=>p.slug.includes('wellcare'))].filter(Boolean)}/><a href="/portfolio/projects/">All projects →</a></div></section>
<section id="about" class="chapter"><div class="chapter-body"><h2>About Sej</h2><p class="lede">I’m {info.name}, a full-stack and AI developer based in {info.location}. I help businesses automate operations, connect systems and deliver reliable software.</p><p>Previously SaaS Application Engineer at Accenture / ReadyTech and Software Developer at Central Luzon Doctors’ Hospital.</p><div class="actions about-actions"><a class="button" href="/portfolio/technologies/">Technologies Used</a><a class="button primary" href="/portfolio/about/">My Career Profile</a></div></div></section>
<section id="writing" class="chapter"><div class="chapter-body"><span id="blog"></span><h2>Technical writing</h2><Cards entries={posts.slice(0,2)}/><a href="/portfolio/posts/">All writing →</a></div></section>
<section id="contact" class="chapter"><div class="chapter-body"><h2>Get in touch</h2><p class="lede">Have a role in mind or a project to build?</p><div class="actions"><a class="button primary" href={`mailto:${info.contact.email}?subject=Employment%20opportunity`}>Employment inquiries</a><a class="button" href={`mailto:${info.contact.email}?subject=Freelance%20project`}>Freelance projects</a></div><p><a href={info.contact.github}>GitHub</a> · <a href={info.contact.linkedin}>LinkedIn</a> · <a href="/portfolio/rss.xml">RSS</a></p></div></section>
</main><div class="pager" hidden><span id="position">01 / 05</span><span class="track"></span><button id="prev" aria-label="Previous chapter">←</button><button id="next" aria-label="Next chapter">→</button></div><Splash slot="overlay"/></Base>
<script>import '../scripts/chapters.js';</script>
