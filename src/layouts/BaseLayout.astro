---
import regularFont from '@fontsource/roboto/files/roboto-latin-400-normal.woff2?url';
import boldFont from '@fontsource/roboto/files/roboto-latin-700-normal.woff2?url';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { chapters, resolveTheme, splashEligible } from '../utils/portfolio.mjs';
import { beginEntrance } from '../scripts/entrance-bootstrap.mjs';
const {title, home = false, career = false} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const entries = [...await getCollection('projects'), ...await getCollection('posts')];
const sections = career ? ['experience','education','certifications'] : chapters;
const chapterLinks = sections.map(id => ({
  id, label: id[0].toUpperCase() + id.slice(1), href: (career ? '' : base) + '#' + id
}));
const themeScript = `let stored;try{stored=localStorage.getItem('theme')}catch{}document.documentElement.dataset.theme=(${resolveTheme.toString()})(stored,matchMedia('(prefers-color-scheme:dark)').matches)`;
---
<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={regularFont}/>
<link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={boldFont}/>
<title>{title} · Sej</title><meta name="description" content="Software, AI workflows and technical writing by Sej, a full-stack and AI developer in Tarlac, Philippines."/>
<link rel="icon" href={base+'sej-logo.ico'}/><link rel="alternate" type="application/rss+xml" title="Sej’s writing" href={base+'rss.xml'}/>
<script is:inline set:html={themeScript}></script>
</head><body>
<slot name="overlay"/>
<div id="site-shell">
{home && <script is:inline set:html={`(${beginEntrance.toString()})(${splashEligible.toString()});`}></script>}
<header class="mast">
<a class="brand" href={base+'#intro'} aria-label="Sej — home"><img src={base+'sej-logo.svg'} width="64" height="48" alt=""/></a>
<nav class="desktop-nav" aria-label={career ? 'Career sections' : 'Chapters'}>{chapterLinks.map(c=><a data-chapter={c.id} href={c.href}>{c.label}</a>)}</nav>
<details class="mobile-nav"><summary><span id="current-chapter">{career?'Sections':home?'Intro':'Chapters'}</span> ▾</summary><nav aria-label={career ? 'Career sections' : 'Mobile chapters'}>{chapterLinks.map(c=><a data-chapter={c.id} href={c.href}>{c.label}</a>)}</nav></details>
<div class="utilities">{career && <a class="profile-back" href={base+'#about'} aria-label="Back to About">← <span>About</span></a>}<button id="search-open" hidden aria-label="Search portfolio"><svg viewBox="0 0 24 24"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 5 5"/></svg></button><button id="theme" hidden aria-label="Toggle color theme"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg></button></div>
</header>
<slot/>
<dialog id="search-box" aria-labelledby="search-title"><div class="spread"><h2 id="search-title">Search portfolio</h2><button id="close-search" aria-label="Close search">×</button></div><input id="query" type="search" autofocus placeholder="Search projects and writing" aria-label="Search projects and writing"/><div class="search-results"><ul>{entries.map(e=><li data-description={e.data.description}><a href={base+e.collection+'/'+e.slug+'/'}>{e.data.title.trim()}</a></li>)}</ul><p id="empty-search" hidden>No matches.</p></div></dialog>
</div>
<script>
 import '../scripts/header.js';
 const theme = document.querySelector<HTMLButtonElement>('#theme')!;
 theme.hidden=false;
 theme.onclick=()=>{
   const next=document.documentElement.dataset.theme==='dark'?'light':'dark';
   document.documentElement.dataset.theme=next;
   try { localStorage.setItem('theme',next); } catch {}
 };
 const dialog=document.querySelector<HTMLDialogElement>('#search-box')!;
 const open=document.querySelector<HTMLButtonElement>('#search-open')!;
 open.hidden=false;
 open.onclick=()=>dialog.showModal();
 document.querySelector<HTMLButtonElement>('#close-search')!.onclick=()=>dialog.close();
 const query=dialog.querySelector<HTMLInputElement>('input')!;
 const items=Array.from(dialog.querySelectorAll('li'));
 query.oninput=()=>{
   const term=query.value.trim().toLowerCase();
   for(const item of items) item.hidden=!(item.textContent+' '+item.dataset.description).toLowerCase().includes(term);
   dialog.querySelector<HTMLElement>('#empty-search')!.hidden=items.some(i=>!i.hidden);
 };
 dialog.addEventListener('close',()=>{query.value='';query.dispatchEvent(new Event('input'));});
</script></body></html>
